/* FotoDown Modern Fluent Dark Theme (Cross-Platform Windows & Linux) */

QWidget {
    background-color: #0f172a;
    color: #f8fafc;
    font-family: "Segoe UI", Ubuntu, -apple-system, sans-serif;
    font-size: 13px;
}

/* Header Banner */
#headerBanner {
    background-color: #1e293b;
    border-bottom: 1px solid #334155;
}

#logoIcon {
    font-size: 22px;
}

#appTitle {
    font-size: 17px;
    font-weight: 700;
    color: #38bdf8;
}

#versionBadge {
    background-color: #0369a1;
    color: #e0f2fe;
    font-size: 10px;
    font-weight: bold;
    padding: 2px 7px;
    border-radius: 10px;
}

#subtleLabel {
    color: #94a3b8;
    font-size: 12px;
}

/* Collapsible Sections */
#collapsibleHeader {
    background-color: #1e293b;
    border-radius: 6px;
}

#sectionTitle {
    font-weight: 600;
    font-size: 13px;
    color: #e2e8f0;
}

#toggleBtn {
    background: transparent;
    border: none;
    color: #38bdf8;
    font-size: 11px;
}

#collapsibleContent {
    background-color: #162032;
    border: 1px solid #1e293b;
    border-top: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Input Fields */
QLineEdit {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f8fafc;
    selection-background-color: #0284c7;
}

QLineEdit:focus {
    border: 1px solid #38bdf8;
}

/* ComboBox */
QComboBox {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f8fafc;
    min-height: 20px;
}

QComboBox:focus, QComboBox:hover {
    border: 1px solid #38bdf8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    border: 1px solid #334155;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
    padding: 4px;
}

/* Buttons */
QPushButton {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
    color: #f8fafc;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #475569;
}

QPushButton:pressed {
    background-color: #0f172a;
}

QPushButton:disabled {
    background-color: #1e293b;
    color: #475569;
    border-color: #1e293b;
}

#primaryBtn {
    background-color: #0284c7;
    border: 1px solid #0284c7;
    color: #ffffff;
    font-weight: 600;
    padding: 8px 18px;
}

#primaryBtn:hover {
    background-color: #0369a1;
    border-color: #0369a1;
}

#scanBtn {
    background-color: #1e293b;
    border: 1px solid #38bdf8;
    color: #38bdf8;
    font-weight: 600;
    padding: 8px 18px;
}

#scanBtn:hover {
    background-color: #0369a1;
    color: #ffffff;
}

#dangerBtn {
    background-color: #991b1b;
    border: 1px solid #dc2626;
    color: #fee2e2;
}

#dangerBtn:hover {
    background-color: #b91c1c;
}

#chipBtn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
}

#chipBtn:hover {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
}

#tagChip {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    color: #7dd3fc;
}

#tagChip:hover {
    background-color: #0284c7;
    color: #ffffff;
}

/* Checkbox & Radio Buttons */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e2e8f0;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #475569;
    border-radius: 4px;
    background-color: #0f172a;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0284c7;
    border-color: #0284c7;
}

/* Live Preview Box */
#previewBox {
    background-color: #090e17;
    border: 1px dashed #334155;
    border-radius: 6px;
}

#previewTitle {
    color: #38bdf8;
    font-weight: 600;
    font-size: 11px;
}

#previewText {
    color: #a5f3fc;
    font-family: monospace;
    font-size: 12px;
}

/* Progress Bar */
QProgressBar {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 5px;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #38bdf8);
    border-radius: 4px;
}

/* Table View */
QTableView {
    background-color: #0f172a;
    alternate-background-color: #162032;
    border: 1px solid #1e293b;
    border-radius: 6px;
    gridline-color: transparent;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
}

QTableView::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #1e293b;
    color: #94a3b8;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #0f172a;
    border-bottom: 2px solid #334155;
    font-weight: 600;
}

/* List / Gallery View */
QListView {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
}

/* ScrollBars */
QScrollBar:vertical {
    border: none;
    background: #0f172a;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 25px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #0f172a;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 25px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #475569;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #1e293b;
    color: #94a3b8;
    border-top: 1px solid #334155;
    font-size: 12px;
}


/* Storage Card & Disk Usage */
#storageCard {
    background-color: #162032;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

#storageTitle {
    font-size: 12px;
    font-weight: 600;
    color: #e2e8f0;
}

#storageInfo {
    font-size: 11px;
    color: #94a3b8;
}

/* Zoom Slider */
QSlider::groove:horizontal {
    border: 1px solid #334155;
    background: #1e293b;
    height: 6px;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #0284c7;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #38bdf8;
    border: 1px solid #0284c7;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #7dd3fc;
}
