/* Vitrina Modern Fluent Dark Theme (Cross-Platform Windows & Linux) */

QWidget {
    background-color: #0f172a;
    color: #f8fafc;
    font-family: "Segoe UI", Ubuntu, -apple-system, sans-serif;
    font-size: 13px;
}

/* Typography Scale Tokens */
.microText {
    font-size: 10px;
    font-weight: 600;
}

.captionText {
    font-size: 11px;
    font-weight: 500;
}

.bodyText {
    font-size: 12px;
}

.subheadingText {
    font-size: 14px;
    font-weight: 600;
}

.titleText {
    font-size: 16px;
    font-weight: 700;
}

.textMuted {
    color: #94a3b8;
}

.textAccent {
    color: #38bdf8;
}

.textMono {
    font-family: Consolas, "Cascadia Code", "Ubuntu Mono", monospace;
    font-size: 11px;
}

/* Header Banner */
#headerBanner {
    background-color: #1e293b;
    border-bottom: 1px solid #334155;
    max-height: 42px;
}

#logoIcon {
    font-size: 16px;
}

#appTitle {
    font-size: 15px;
    font-weight: 700;
    color: #38bdf8;
}

#versionBadge {
    background-color: #0369a1;
    color: #e0f2fe;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 4px;
    max-height: 18px;
}

#subtleLabel {
    color: #94a3b8;
    font-size: 12px;
}

QPushButton#headerTabBtn {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 10px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton#headerTabBtn:hover {
    background-color: #273549;
    color: #f1f5f9;
    border-color: #475569;
}

QPushButton#headerTabBtn:checked {
    background-color: #0284c7;
    color: #ffffff;
    border: 1px solid #38bdf8;
}

/* Collapsible Sections */
#collapsibleHeader {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
}

#collapsibleHeader:hover {
    background-color: #273549;
    border-color: #0284c7;
}

#chevronIcon {
    font-size: 11px;
    font-weight: bold;
    color: #38bdf8;
    margin-right: 2px;
}

#sectionTitle {
    font-weight: 600;
    font-size: 13px;
    color: #f1f5f9;
}

#toggleHint {
    font-size: 11px;
    color: #38bdf8;
    background-color: #0f172a;
    border: 1px solid #0284c7;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
}

#toggleHint:hover {
    background-color: #0284c7;
    color: #ffffff;
}

#collapsibleContent {
    background-color: #162032;
    border: 1px solid #1e293b;
    border-top: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Input Fields */
QLineEdit {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f8fafc;
    selection-background-color: #0284c7;
}

QLineEdit:focus {
    border: 1px solid #38bdf8;
}

/* ComboBox */
QComboBox {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f8fafc;
    min-height: 20px;
}

QComboBox:focus, QComboBox:hover {
    border: 1px solid #38bdf8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    border: 1px solid #334155;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
    padding: 4px;
}

/* Buttons */
QPushButton {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
    color: #f8fafc;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #475569;
}

QPushButton:pressed {
    background-color: #0f172a;
}

QPushButton:disabled {
    background-color: #1e293b;
    color: #475569;
    border-color: #1e293b;
}

#primaryBtn {
    background-color: #0284c7;
    border: 1px solid #0284c7;
    color: #ffffff;
    font-weight: 600;
    padding: 8px 18px;
}

#primaryBtn:hover {
    background-color: #0369a1;
    border-color: #0369a1;
}

#scanBtn {
    background-color: #1e293b;
    border: 1px solid #38bdf8;
    color: #38bdf8;
    font-weight: 600;
    padding: 8px 18px;
}

#scanBtn:hover {
    background-color: #0369a1;
    color: #ffffff;
}

#dangerBtn {
    background-color: #991b1b;
    border: 1px solid #dc2626;
    color: #fee2e2;
}

#dangerBtn:hover {
    background-color: #b91c1c;
}

#chipBtn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
}

#chipBtn:hover {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
}

#tagChip {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    color: #7dd3fc;
}

#tagChip:hover {
    background-color: #0284c7;
    color: #ffffff;
}

/* Profile Action Icon Buttons */
QPushButton#profileBtnSave,
QPushButton#profileBtnNew,
QPushButton#profileBtnDelete {
    padding: 0px;
    margin: 0px;
    font-size: 13px;
    font-family: "Segoe UI Emoji", "Segoe UI Symbol", "Segoe UI", sans-serif;
    border-radius: 6px;
    background-color: #1e293b;
    border: 1px solid #334155;
}

QPushButton#profileBtnSave {
    border-color: #0369a1;
    color: #38bdf8;
}

QPushButton#profileBtnSave:hover {
    background-color: #0284c7;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton#profileBtnNew {
    border-color: #047857;
    color: #34d399;
}

QPushButton#profileBtnNew:hover {
    background-color: #059669;
    border-color: #34d399;
    color: #ffffff;
}

QPushButton#profileBtnDelete {
    border-color: #991b1b;
    color: #f87171;
}

QPushButton#profileBtnDelete:hover {
    background-color: #dc2626;
    border-color: #f87171;
    color: #ffffff;
}

QPushButton#profileBtnDelete:disabled {
    background-color: #0f172a;
    border-color: #1e293b;
    color: #475569;
}

/* Checkbox & Radio Buttons */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e2e8f0;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #475569;
    border-radius: 4px;
    background-color: #0f172a;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0284c7;
    border-color: #0284c7;
}

/* Live Preview Box */
#previewBox {
    background-color: #090e17;
    border: 1px dashed #334155;
    border-radius: 6px;
}

#previewTitle {
    color: #38bdf8;
    font-weight: 600;
    font-size: 11px;
}

#previewText {
    color: #a5f3fc;
    font-family: monospace;
    font-size: 12px;
}

/* Progress Bar */
QProgressBar {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 5px;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #38bdf8);
    border-radius: 4px;
}

/* Table & Tree Views */
QTableView, QTreeView {
    background-color: #090d16;
    alternate-background-color: #162032;
    border: 1px solid #1e293b;
    border-radius: 6px;
    gridline-color: transparent;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
    color: #e2e8f0;
}

QTableView::item, QTreeView::item {
    padding: 4px 6px;
    border-radius: 3px;
}

QTableView::item:hover, QTreeView::item:hover {
    background-color: #1e293b;
}

QTableView::item:selected, QTreeView::item:selected {
    background-color: #1e3a8a;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #0f172a;
    color: #94a3b8;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #1e293b;
    border-bottom: 1px solid #1e293b;
    font-size: 10px;
    font-weight: bold;
}

/* List / Gallery View */
QListView, QListWidget {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    color: #e2e8f0;
}

QListView::item, QListWidget::item {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    color: #e2e8f0;
}

QListView::item:selected, QListWidget::item:selected {
    background-color: #0284c7;
    border: 1px solid #38bdf8;
    color: #ffffff;
}

/* ScrollBars */
QScrollBar:vertical {
    border: none;
    background: #0f172a;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 25px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #0f172a;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 25px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #475569;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #1e293b;
    color: #94a3b8;
    border-top: 1px solid #334155;
    font-size: 12px;
}


/* Storage Card & Disk Usage */
#storageCard {
    background-color: #162032;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

#storageTitle {
    font-size: 12px;
    font-weight: 600;
    color: #e2e8f0;
}

#storageInfo {
    font-size: 11px;
    color: #94a3b8;
}

/* Zoom Slider */
QSlider::groove:horizontal {
    border: 1px solid #334155;
    background: #1e293b;
    height: 6px;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #0284c7;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #38bdf8;
    border: 1px solid #0284c7;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #7dd3fc;
}


#sectionSubTitle {
    font-size: 12px;
    font-weight: 600;
    color: #cbd5e1;
}


/* Card Hotplug Notification Banner */
#cardNotification {
    background-color: #064e3b;
    border-bottom: 2px solid #059669;
    padding: 6px 14px;
}

#cardNotificationLabel {
    color: #ecfdf5;
    font-size: 13px;
    font-weight: 500;
}

#btnCardScan {
    background-color: #059669;
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
}

#btnCardScan:hover {
    background-color: #10b981;
}

#btnCardDismiss {
    background: transparent;
    color: #a7f3d0;
    font-size: 12px;
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 4px 10px;
}

#btnCardDismiss:hover {
    background-color: #047857;
    color: #ffffff;
}


/* Profile Bar */
#profileBar {
    background-color: #162032;
    border: 1px solid #334155;
    border-radius: 6px;
}

/* Context & Settings Dropdown Menus */
QMenu {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #0284c7;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #64748b;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #334155;
    margin: 4px 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

/* TabWidget Panels (e.g. Left Dock, Settings) */
QTabWidget::pane {
    border: none;
    background-color: #090d16;
}

QTabBar::tab {
    background-color: #0b1120;
    color: #94a3b8;
    border: 1px solid #1e293b;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 14px;
    margin-right: 2px;
    font-weight: 600;
    font-size: 11px;
}

QTabBar::tab:selected {
    background-color: #0f172a;
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    background-color: #1e293b;
    color: #f8fafc;
}

/* Left Dock Collapsed Strip */
#cullingLeftDockStrip {
    background-color: #090d16;
    border-right: 1px solid #1e293b;
}

QPushButton#btnStripExpand {
    background-color: #1e293b;
    border: 1px solid #38bdf8;
    border-radius: 4px;
}
QPushButton#btnStripExpand:hover {
    background-color: #0369a1;
}

QPushButton#btnStripNav {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QPushButton#btnStripNav:hover {
    background-color: #1e293b;
    border-color: #334155;
}

/* Tree Header Card & Tools */
#treeHeaderCard {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 6px;
}

QLabel#treeTitleLabel {
    font-size: 11px;
    font-weight: bold;
    color: #94a3b8;
}

QLabel#treeRootPathLabel {
    color: #94a3b8;
    font-size: 10px;
}

QPushButton#treeToolBtn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 3px;
}
QPushButton#treeToolBtn:hover {
    background-color: #334155;
    border-color: #38bdf8;
}

QPushButton#btnChangeRoot {
    background-color: #1e293b;
    color: #38bdf8;
    border: 1px solid #0284c7;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#btnChangeRoot:hover {
    background-color: #0369a1;
    color: #ffffff;
}

/* Filter Head Frame & Filter Cards */
#filterHeadFrame {
    background-color: #0b1120;
    border-bottom: 1px solid #1e293b;
}

QLabel#filterHeaderTitle {
    font-size: 11px;
    font-weight: bold;
    color: #f8fafc;
    letter-spacing: 0.5px;
}

#filterScrollArea {
    background-color: #090d16;
    border: none;
}

#filterSectionCard {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 6px;
}

#filterStatsCard {
    background-color: #0b1329;
    border: 1px solid #1e3a8a;
    border-radius: 6px;
    padding: 6px;
}

QPushButton#btnFilterReset {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    font-weight: 500;
}
QPushButton#btnFilterReset:hover {
    background-color: #334155;
    color: #f8fafc;
}

/* Transfer Tab Cards & Center Panel */
#folderCard {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 3px;
}

#filterCard {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 3px;
}

#centerActionPanel {
    background-color: #0b0f19;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

#transferProgressFrame {
    background-color: #1e293b;
    border-radius: 6px;
    padding: 6px;
}

QPushButton#compactToolBtn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 3px;
}
QPushButton#compactToolBtn:hover {
    background-color: #334155;
    border-color: #38bdf8;
}

QPushButton#toggleNavBtn {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    color: #94a3b8;
}
QPushButton#toggleNavBtn:checked {
    background-color: #0284c7;
    color: white;
    border-color: #38bdf8;
}

QPushButton#btnRenameTransfer {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 10px;
    color: #38bdf8;
    font-weight: 600;
}
QPushButton#btnRenameTransfer:hover {
    background-color: #0284c7;
    color: white;
    border-color: #38bdf8;
}

/* Empty State Frame */
#emptyStateFrame {
    background-color: #0b1120;
    border: 1px dashed #334155;
    border-radius: 12px;
}
#emptyStateTitle {
    font-size: 20px;
    font-weight: bold;
    color: #f8fafc;
}
#emptyStateDesc {
    font-size: 13px;
    color: #94a3b8;
}

/* Single View Header & Footer */
#singleViewHeader, #singleViewFooter {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
}
#singleViewHeader QLabel, #singleViewFooter QLabel {
    color: #cbd5e1;
}
#singleViewHeader QCheckBox {
    font-weight: 600;
    font-size: 12px;
    color: #f8fafc;
}

QScrollArea#photoCanvasArea {
    background-color: #0b1120;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

QLabel#tagChip {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 2px 6px;
    color: #cbd5e1;
    font-size: 11px;
}

QPushButton#chipBtn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 8px;
    color: #cbd5e1;
    font-size: 11px;
}
QPushButton#chipBtn:hover {
    background-color: #334155;
    border-color: #38bdf8;
    color: #ffffff;
}

/* EXIF Inspector Section Boxes */
#renameConfigCard {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

#exifSectionBox {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
}
#exifPreviewFrame {
    background-color: #0b1120;
    border: 1px solid #1e293b;
    border-radius: 6px;
}
#exifExposureChip {
    background-color: #1e293b;
    color: #38bdf8;
    font-weight: bold;
    font-size: 12px;
    border-radius: 4px;
    padding: 4px 8px;
}
#exifFilenameLabel {
    font-weight: 600;
    font-size: 12px;
    color: #f1f5f9;
}

/* Center Transfer Action Buttons (Dark Mode) */
QPushButton#btnReconcile {
    background-color: #1e293b;
    color: #fbbf24;
    border: 1px solid #d97706;
    font-weight: bold;
    border-radius: 5px;
    padding: 7px 6px;
    font-size: 11px;
}
QPushButton#btnReconcile:hover {
    background-color: #d97706;
    color: #ffffff;
}
QPushButton#btnReconcile::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 12px;
}

QPushButton#btnCopySel {
    background-color: #0284c7;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #0284c7;
    border-radius: 5px;
    padding: 7px 6px;
    font-size: 11px;
}
QPushButton#btnCopySel:hover {
    background-color: #0369a1;
}
QPushButton#btnCopySel:disabled {
    background-color: #334155;
    color: #64748b;
    border: 1px solid #334155;
}

QPushButton#btnMoveSel {
    background-color: #0d9488;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #0d9488;
    border-radius: 5px;
    padding: 7px 6px;
    font-size: 11px;
}
QPushButton#btnMoveSel:hover {
    background-color: #0f766e;
}
QPushButton#btnMoveSel:disabled {
    background-color: #334155;
    color: #64748b;
    border: 1px solid #334155;
}

QPushButton#btnCopyAll {
    background-color: #1e293b;
    color: #38bdf8;
    border: 1px solid #0284c7;
    font-weight: 600;
    border-radius: 5px;
    padding: 6px;
    font-size: 11px;
}
QPushButton#btnCopyAll:hover {
    background-color: #0284c7;
    color: #ffffff;
}
QPushButton#btnCopyAll:disabled {
    background-color: #1e293b;
    color: #475569;
    border-color: #334155;
}

QPushButton#btnMoveAll {
    background-color: #1e293b;
    color: #2dd4bf;
    border: 1px solid #0d9488;
    font-weight: 600;
    border-radius: 5px;
    padding: 6px;
    font-size: 11px;
}
QPushButton#btnMoveAll:hover {
    background-color: #0d9488;
    color: #ffffff;
}
QPushButton#btnMoveAll:disabled {
    background-color: #1e293b;
    color: #475569;
    border-color: #334155;
}

#transferSeparator {
    color: #334155;
    margin: 3px 0;
}

QProgressBar#transferProgressBar {
    background-color: #0b0f19;
    border: 1px solid #334155;
    border-radius: 3px;
    text-align: center;
    color: white;
    font-size: 9px;
    font-weight: bold;
}
QProgressBar#transferProgressBar::chunk {
    background-color: #0284c7;
    border-radius: 2px;
}

/* Secondary Button Standard */
QPushButton#secondaryBtn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 4px 10px;
    color: #f1f5f9;
    font-weight: 500;
}
QPushButton#secondaryBtn:hover {
    background-color: #334155;
    border-color: #38bdf8;
    color: #ffffff;
}

/* Culling Sidebar Cards & Buttons (Dark Mode) */
#cullingSidebarCard {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 6px;
}

QPushButton#cullingToggleRawJpg {
    background-color: #1e293b;
    color: #38bdf8;
    border: 1px solid #0284c7;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 600;
}
QPushButton#cullingToggleRawJpg:hover {
    background-color: #0369a1;
    color: #ffffff;
}

QPushButton#cullingNavBtn {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 10px;
    font-weight: 500;
}
QPushButton#cullingNavBtn:hover {
    background-color: #334155;
}

QPushButton#cullingZoomBtn {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px;
    font-size: 11px;
}
QPushButton#cullingZoomBtn:hover {
    background-color: #334155;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton#cullingStarBtn {
    background-color: #1e293b;
    color: #fbbf24;
    border: 1px solid #334155;
    border-radius: 4px;
    font-weight: bold;
    font-size: 11px;
}
QPushButton#cullingStarBtn:hover {
    background-color: #d97706;
    color: #ffffff;
    border-color: #f59e0b;
}

QPushButton#cullingZeroBtn {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 4px;
    font-size: 10px;
}
QPushButton#cullingZeroBtn:hover {
    background-color: #334155;
    color: #ffffff;
}

QPushButton#cullingPickBtn {
    background-color: #065f46;
    color: #a7f3d0;
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 5px;
    font-weight: 600;
    font-size: 11px;
}
QPushButton#cullingPickBtn:hover {
    background-color: #047857;
    color: #ffffff;
}

QPushButton#cullingRejectBtn {
    background-color: #7f1d1d;
    color: #fca5a5;
    border: 1px solid #b91c1c;
    border-radius: 4px;
    padding: 5px;
    font-weight: 600;
    font-size: 11px;
}
QPushButton#cullingRejectBtn:hover {
    background-color: #991b1b;
    color: #ffffff;
}

#cullingWfBadge {
    background-color: #334155;
    color: #cbd5e1;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: bold;
}

QPushButton#cullingWfBtn {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 5px;
    font-size: 11px;
}
QPushButton#cullingWfBtn:hover {
    background-color: #334155;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton#cullingDarktableBtn {
    background-color: #831843;
    color: #fbcfe8;
    border: 1px solid #be185d;
    border-radius: 4px;
    padding: 6px 10px;
    font-weight: bold;
    font-size: 11px;
    text-align: left;
}
QPushButton#cullingDarktableBtn:hover {
    background-color: #9d174d;
    color: #ffffff;
}

QPushButton#cullingTopazBtn {
    background-color: #1e3a8a;
    color: #bfdbfe;
    border: 1px solid #2563eb;
    border-radius: 4px;
    padding: 6px 10px;
    font-weight: bold;
    font-size: 11px;
    text-align: left;
}
QPushButton#cullingTopazBtn:hover {
    background-color: #1d4ed8;
    color: #ffffff;
}

QPushButton#cullingApplyRejectBtn {
    background-color: #334155;
    color: #f87171;
    border: 1px solid #475569;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
    text-align: left;
}
QPushButton#cullingApplyRejectBtn:hover {
    background-color: #475569;
    color: #ffffff;
}

/* Canvas Area, Top Strip & Filmstrip (Dark Mode) */
#cullingCanvasTopStrip {
    background-color: #070a12;
    border-bottom: 1px solid #1e293b;
    padding: 2px 6px;
}

#cullingCanvasPathBadge {
    color: #94a3b8;
    font-size: 11px;
    background-color: #1e293b;
    border-radius: 3px;
    padding: 1px 6px;
}

QPushButton#cullingToggleFilmstripBtn {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
}
QPushButton#cullingToggleFilmstripBtn:hover {
    background-color: #334155;
    color: #ffffff;
}

#cullingCanvas {
    background-color: #0b0f19;
    border: none;
}

#cullingFilmstrip {
    background-color: #090d16;
    border-top: 1px solid #1e293b;
}
#cullingFilmstrip QWidget {
    background-color: #090d16;
}

QFrame#filmstripCard {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
}
QFrame#filmstripCard:hover {
    border-color: #38bdf8;
}
QFrame#filmstripCard[active="true"] {
    border: 2px solid #38bdf8;
    background-color: #0c4a6e;
}

/* GroupBox & Settings Dialog (Dark Mode) */
QGroupBox {
    border: 1px solid #1e293b;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 14px;
    font-weight: bold;
    color: #38bdf8;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
}

#settingsPreviewCard {
    background-color: #070d1a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 8px 12px;
}

