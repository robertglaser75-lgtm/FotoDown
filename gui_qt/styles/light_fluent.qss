/* FotoDown Modern Fluent Light Theme (Cross-Platform Windows & Linux) */

QWidget {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: "Segoe UI", Ubuntu, -apple-system, sans-serif;
    font-size: 13px;
}

/* Header Banner */
#headerBanner {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    max-height: 42px;
}

#logoIcon {
    font-size: 16px;
}

#appTitle {
    font-size: 15px;
    font-weight: 700;
    color: #0284c7;
}

#versionBadge {
    background-color: #e0f2fe;
    color: #0369a1;
    border: 1px solid #bae6fd;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 4px;
    max-height: 18px;
}

#subtleLabel {
    color: #475569;
    font-size: 12px;
}

/* Header Tabs */
QPushButton#headerTabBtn {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px 10px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton#headerTabBtn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
    border-color: #94a3b8;
}

QPushButton#headerTabBtn:checked {
    background-color: #0284c7;
    color: #ffffff;
    border: 1px solid #0369a1;
}

/* Collapsible Sections */
#collapsibleHeader {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
}

#collapsibleHeader:hover {
    background-color: #f1f5f9;
    border-color: #0284c7;
}

#chevronIcon {
    font-size: 11px;
    font-weight: bold;
    color: #0284c7;
    margin-right: 2px;
}

#sectionTitle {
    font-weight: 600;
    font-size: 13px;
    color: #0f172a;
}

#toggleHint {
    font-size: 11px;
    color: #0369a1;
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
}

#toggleHint:hover {
    background-color: #0284c7;
    color: #ffffff;
}

#collapsibleContent {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Input Fields */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
    color: #0f172a;
    selection-background-color: #e0f2fe;
    selection-color: #0369a1;
}

QLineEdit:focus {
    border: 1px solid #0284c7;
}

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
    color: #0f172a;
    min-height: 20px;
}

QComboBox:focus, QComboBox:hover {
    border: 1px solid #0284c7;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    selection-background-color: #e0f2fe;
    selection-color: #0369a1;
    color: #0f172a;
    padding: 4px;
}

/* Buttons */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
    color: #0f172a;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

#primaryBtn {
    background-color: #0284c7;
    border: 1px solid #0284c7;
    color: #ffffff;
    font-weight: 600;
    padding: 8px 18px;
}

#primaryBtn:hover {
    background-color: #0369a1;
    border-color: #0369a1;
}

#scanBtn {
    background-color: #ffffff;
    border: 1px solid #0284c7;
    color: #0284c7;
    font-weight: 600;
    padding: 8px 18px;
}

#scanBtn:hover {
    background-color: #0284c7;
    color: #ffffff;
}

#dangerBtn {
    background-color: #dc2626;
    border: 1px solid #dc2626;
    color: #ffffff;
}

#dangerBtn:hover {
    background-color: #b91c1c;
}

#chipBtn {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
    color: #334155;
}

#chipBtn:hover {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
}

#tagChip {
    background-color: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    color: #0369a1;
}

#tagChip:hover {
    background-color: #0284c7;
    color: #ffffff;
}

/* Profile Action Icon Buttons */
QPushButton#profileBtnSave,
QPushButton#profileBtnNew,
QPushButton#profileBtnDelete {
    padding: 0px;
    margin: 0px;
    border-radius: 6px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
}

QPushButton#profileBtnSave {
    border-color: #0284c7;
    color: #0284c7;
}

QPushButton#profileBtnSave:hover {
    background-color: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
}

QPushButton#profileBtnNew {
    border-color: #16a34a;
    color: #16a34a;
}

QPushButton#profileBtnNew:hover {
    background-color: #16a34a;
    border-color: #16a34a;
    color: #ffffff;
}

QPushButton#profileBtnDelete {
    border-color: #dc2626;
    color: #dc2626;
}

QPushButton#profileBtnDelete:hover {
    background-color: #dc2626;
    border-color: #dc2626;
    color: #ffffff;
}

QPushButton#profileBtnDelete:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    color: #94a3b8;
}

/* Checkbox & Radio Buttons */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #0f172a;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    background-color: #ffffff;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0284c7;
    border-color: #0284c7;
}

/* Live Preview Box */
#previewBox {
    background-color: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 6px;
}

#previewTitle {
    color: #0284c7;
    font-weight: 600;
    font-size: 11px;
}

#previewText {
    color: #0f172a;
    font-family: monospace;
    font-size: 12px;
}

/* Progress Bar */
QProgressBar {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    text-align: center;
    color: #0f172a;
    font-size: 11px;
    font-weight: bold;
    height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #38bdf8);
    border-radius: 4px;
}

/* Table View */
QTableView, QTreeView {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    gridline-color: #f1f5f9;
    selection-background-color: #e0f2fe;
    selection-color: #0369a1;
    color: #0f172a;
}

QTableView::item, QTreeView::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #334155;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 2px solid #cbd5e1;
    font-weight: 600;
}

/* List / Gallery View */
QListView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #0f172a;
}

/* ScrollBars */
QScrollBar:vertical {
    border: none;
    background: #f8fafc;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 25px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #f8fafc;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 25px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #ffffff;
    color: #475569;
    border-top: 1px solid #e2e8f0;
    font-size: 12px;
}

/* Storage Card & Disk Usage */
#storageCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

#storageTitle {
    font-size: 12px;
    font-weight: 600;
    color: #0f172a;
}

#storageInfo {
    font-size: 11px;
    color: #475569;
}

/* Zoom Slider */
QSlider::groove:horizontal {
    border: 1px solid #cbd5e1;
    background: #f1f5f9;
    height: 6px;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #0284c7;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #0284c7;
    border: 1px solid #0369a1;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #0369a1;
}

#sectionSubTitle {
    font-size: 12px;
    font-weight: 600;
    color: #334155;
}

/* Card Hotplug Notification Banner */
#cardNotification {
    background-color: #ecfdf5;
    border-bottom: 2px solid #10b981;
    padding: 6px 14px;
}

#cardNotificationLabel {
    color: #065f46;
    font-size: 13px;
    font-weight: 500;
}

#btnCardScan {
    background-color: #10b981;
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
}

#btnCardScan:hover {
    background-color: #059669;
}

#btnCardDismiss {
    background: transparent;
    color: #047857;
    font-size: 12px;
    border: 1px solid #10b981;
    border-radius: 4px;
    padding: 4px 10px;
}

#btnCardDismiss:hover {
    background-color: #a7f3d0;
}

/* Profile Bar */
#profileBar {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
}

/* Context & Settings Dropdown Menus */
QMenu {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    color: #0f172a;
}

QMenu::item:selected {
    background-color: #e0f2fe;
    color: #0369a1;
}

QMenu::item:disabled {
    color: #94a3b8;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #e2e8f0;
    margin: 4px 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

/* TabWidget Panels (e.g. Settings Dialog) */
QTabWidget::pane {
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
    border-radius: 6px;
    padding: 10px;
}

QTabBar::tab {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 14px;
    margin-right: 2px;
    font-weight: 600;
    font-size: 11px;
}

QTabBar::tab:selected {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
}

QTabBar::tab:hover:!selected {
    background-color: #e2e8f0;
    color: #0f172a;
}
